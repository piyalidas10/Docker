        <mxCell id="QcWilovOGVgIscdPZ2Kh-32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=default;fillColor=none;strokeColor=none;fontStyle=1;align=left;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Cloud Controller Manager&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400; letter-spacing: -0.06px; color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;source-serif-pro, Georgia, Cambria, Times New Roman, Times, serif&quot;&gt;1. Basically just translates instructions to AWS or Azure or whatever you&#39;re using.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400; letter-spacing: -0.06px; color: rgb(0, 0, 0);&quot;&gt;&lt;font face=&quot;source-serif-pro, Georgia, Cambria, Times New Roman, Times, serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400; letter-spacing: -0.06px;&quot;&gt;&lt;font face=&quot;source-serif-pro, Georgia, Cambria, Times New Roman, Times, serif&quot;&gt;2.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-weight: 400; letter-spacing: -0.06px;&quot;&gt;&lt;font face=&quot;source-serif-pro, Georgia, Cambria, Times New Roman, Times, serif&quot;&gt;lets us link our cluster to a specific cloud provider’s API, and separates out the components that interact with that cloud platform from components that only interact with our cluster.&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(15, 15, 15); font-family: Roboto, Arial, sans-serif; font-weight: 500;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgba(0, 0, 0, 0.05); color: rgb(15, 15, 15); font-family: Roboto, Arial, sans-serif; font-weight: 500;&quot;&gt;&lt;br&gt;&lt;/s