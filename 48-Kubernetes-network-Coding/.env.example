# =============================================================================
# Environment Variables — 48-Kubernetes-network-Coding
# =============================================================================
# This file documents all environment variables used across the three
# microservices (users-api, tasks-api, auth-api) in both Docker Compose
# and Kubernetes environments.
#
# Copy this file to .env and fill in values as needed.
# DO NOT commit real secrets to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# USERS API  (users-api/users-app.js)
# Listens on port: 8080
# -----------------------------------------------------------------------------

# Address used by users-api to reach auth-api
# Route: /hashed-password/:password  (signup)
# Route: /token/:hashedPassword/:enteredPassword  (login via AUTH_ADDRESS)
#
# Docker Compose value : auth                    (Compose service name)
# Kubernetes value     : auth-service.default    (CoreDNS cluster name)
AUTH_ADDRESS=auth-service.default

# Auto-injected by Kubernetes for every Service as <NAME>_SERVICE_HOST.
# Used in the /login route: process.env.AUTH_SERVICE_SERVICE_HOST
#
# Kubernetes  : injected automatically — no manual setup needed
# Docker Compose : must be set manually to mirror the Kubernetes variable
AUTH_SERVICE_SERVICE_HOST=auth-service.default


# -----------------------------------------------------------------------------
# TASKS API  (tasks-api/tasks-app.js)
# Listens on port: 8000
# -----------------------------------------------------------------------------

# Address used by tasks-api to reach auth-api for token verification
# Route: /verify-token/:token
#
# Docker Compose value : auth
# Kubernetes value     : auth-service.default
AUTH_ADDRESS=auth-service.default

# Folder name inside the container where task files are stored.
# Used as: path.join(__dirname, process.env.TASKS_FOLDER, 'tasks.txt')
#
# Same value in both Docker Compose and Kubernetes.
TASKS_FOLDER=tasks


# -----------------------------------------------------------------------------
# AUTH API  (auth-api/auth-app.js)
# Listens on port: 80
# -----------------------------------------------------------------------------

# Auth API requires NO environment variables.
# It is fully self-contained with no external dependencies.
#
# Endpoints it exposes:
#   GET /hashed-password/:password
#   GET /token/:hashedPassword/:enteredPassword
#   GET /verify-token/:token


# -----------------------------------------------------------------------------
# DOCKER IMAGE NAMES
# Used when building and pushing images to Docker Hub
# Replace 'academind' with your own Docker Hub username if building locally.
# -----------------------------------------------------------------------------
AUTH_IMAGE=academind/kub-demo-auth:latest
USERS_IMAGE=academind/kub-demo-users:latest
TASKS_IMAGE=academind/kub-demo-tasks:latest
FRONTEND_IMAGE=academind/kub-demo-frontend:latest
